# Copy to /etc/vaultspace.env (owner root, mode 600) and fill in. Never commit the real file.
NODE_ENV=production
PORT=443
HOST=0.0.0.0
VS_DATA=/var/lib/vaultspace

# Email for verification codes. Option A: SMTP over TLS (e.g. Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM=your.address@gmail.com

# Option B (if port 465 is blocked): Brevo HTTPS API. Comment out the SMTP lines above.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=verified-sender@example.com
