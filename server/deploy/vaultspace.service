# systemd service for the VaultSpace server, with sandboxing: the process runs as an
# unprivileged user, cannot gain privileges, sees the filesystem read-only except its data
# folder, and gets only the one capability it needs (binding port 443).
[Unit]
Description=VaultSpace server
After=network-online.target
Wants=network-online.target

[Service]
User=vaultspace
Group=vaultspace
WorkingDirectory=/opt/vaultspace/server
EnvironmentFile=/etc/vaultspace.env
ExecStart=/usr/local/bin/node --no-warnings src/index.js
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
# Only IPv4/IPv6 (clients, mail), Unix sockets and netlink (used by DNS lookups).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Only the system calls a normal service needs; anything else fails with "permission denied".
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/vaultspace
UMask=0077

[Install]
WantedBy=multi-user.target
